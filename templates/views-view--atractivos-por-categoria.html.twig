{#
  Vista "atractivos_por_categoria" — listado tipo archive-places.html.
  El hero (nombre del término, imagen, breadcrumb) lo alimenta
  visit_theme_next_preprocess_views_view().
#}
<div class="vn-archive">

  <section class="cat-hero cat-hero--tall" aria-label="{{ 'Atractivos'|t }}">
    {% if vn_term_img_uri %}
    <img class="cat-hero__bg" src="{{ vn_term_img_uri|image_style('ancho') }}" alt="" aria-hidden="true">
    {% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          <li><a href="/que-hacer-en-bogota">{{ 'Descubre Bogotá'|t }}</a></li>
          {% if vn_term_name %}<li><a href="{{ vn_term_url }}">{{ vn_term_name }}</a></li>{% endif %}
          <li aria-current="page">{{ 'Atractivos'|t }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      <h1 class="cat-hero__title">{{ 'Atractivos'|t }}{% if vn_term_name %} {{ 'de'|t }} {{ vn_term_name }}{% endif %}</h1>
    </div>
  </section>

  <section class="archive">
    <div class="archive__wrap{% if not exposed %} archive__wrap--full{% endif %}">

      {% if exposed %}
      <aside class="archive__filters">
        <h2 class="archive__filters-title">{{ 'Filtros'|t }}</h2>
        {{ exposed }}
      </aside>
      {% endif %}

      <div class="archive__results">
        {% if header %}<div class="archive__results-head"><p class="archive__count">{{ header }}</p></div>{% endif %}

        {% if rows %}
          {{ rows }}
        {% elseif empty %}
          <div class="archive__empty">{{ empty }}</div>
        {% endif %}

        {% if pager %}<div class="archive__pager">{{ pager }}</div>{% endif %}
      </div>

    </div>
  </section>

</div>
