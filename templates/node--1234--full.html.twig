{#
  Información al viajero (nodo 1234) — réplica, con el diseño de Visit
  Bogotá, de https://www.idt.gov.co/informacion-al-viajero: intro + acordeón
  de info_util agrupado por categoría (field_categoria_viajero).
  Datos: visit_theme_next_preprocess_node() → info_util_categorias.
  Sin JS: el acordeón usa <details>/<summary> nativos.
#}
<div class="vn-info-viajero">

  <section class="info-viajero__intro">
    <div class="info-viajero__intro-wrap">
      <h1 class="info-viajero__title">{{ node.getTitle() }}</h1>
      {% if node.field_introduccion.value %}
        <p class="info-viajero__lead">{{ node.field_introduccion.value }}</p>
      {% endif %}
      {% if node.body.value %}
        <div class="info-viajero__body">{{ node.body.value|raw }}</div>
      {% endif %}
    </div>
  </section>

  {% if info_util_categorias is not empty %}
  <section class="info-viajero__categorias" aria-label="{{ 'Información útil por categoría'|t }}">
    {% for categoria in info_util_categorias %}
    <div class="info-cat">
      <h2 class="info-cat__title">{{ categoria.name }}</h2>
      <div class="info-cat__grid">
        {% for item in categoria.items %}
        <details class="info-card">
          <summary class="info-card__summary">
            <span class="info-card__media">
              <img class="info-card__img" src="{{ item.image_url ?: 'https://placehold.co/240x240' }}" alt="" loading="lazy" decoding="async">
            </span>
            <span class="info-card__head">
              <span class="info-card__title">{{ item.title }}</span>
              <svg class="info-card__chevron" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="info-card__body">{{ item.body|raw }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

</div>
