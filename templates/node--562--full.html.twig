{#
  Nodo 562 — "Dónde comer": listado de establecimientos con filtros. Estructura
  del prototipo v3 (archive-places.html). Datos: $establecimientos.
  Filtrado por checkbox: behavior "idt-gastro-filter" del tema base
  (necesita .filters, #cardsList, .card[data-*]).
#}
{% set hero_bg = node.field_mainimg.entity
    ? file_url(node.field_mainimg.entity.uri.value)
    : (node.field_cover.entity ? file_url(node.field_cover.entity.uri.value) : '') %}

<div class="vn-archive">

  {# ================= HERO ================= #}
  <section class="cat-hero cat-hero--tall" aria-label="{{ 'ui.where_to_eat'|t }}">
    {% if hero_bg %}<img class="cat-hero__bg" src="{{ hero_bg }}" alt="" aria-hidden="true">{% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          <li aria-current="page">{{ 'ui.where_to_eat'|t }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      <h1 class="cat-hero__title">{{ 'ui.where_to_eat'|t }}</h1>
    </div>
  </section>

  {# ================= LISTADO ================= #}
  <section class="archive">
    <div class="archive__wrap">

      <div class="archive__results-head" style="grid-column:1/-1">
        <p class="archive__count">{{ establecimientos|length }} {{ 'lugares'|t }}</p>
      </div>

      <aside>
        <button class="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="filters-panel">
          <span>{{ 'Filtros'|t }}</span>
          <svg class="filter-toggle-btn__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="filters" id="filters-panel">
          <h3>{{ 'ui.price_range'|t }}</h3>
          {% for cat in taxonomy('rangos_de_precios') %}
          <label for="f-{{ cat.tid }}"><input type="checkbox" id="f-{{ cat.tid }}" value="{{ cat.tid }}"> {{ cat.name }}</label>
          {% endfor %}
          <h3>{{ 'ui.gastro_categories'|t }}</h3>
          {% for cat in taxonomy('categorias_gastronomicas') %}
          <label for="f-{{ cat.tid }}"><input type="checkbox" id="f-{{ cat.tid }}" value="{{ cat.tid }}"> {{ cat.name }}</label>
          {% endfor %}
          <h3>{{ 'ui.zones'|t }}</h3>
          {% for cat in taxonomy('zonas_gastronomicas') %}
          <label for="f-{{ cat.tid }}"><input type="checkbox" id="f-{{ cat.tid }}" value="{{ cat.tid }}"> {{ cat.name }}</label>
          {% endfor %}
        </div>
      </aside>

      <div class="archive__results">
        {% if establecimientos is not empty %}
        <ul class="archive__grid" id="cardsList">
          {% for item in establecimientos|shuffle %}
          {% set categorias = (item.categoria_gastronomica|default([]))|map(t => t.tid)|join(',') %}
          {% set zonas = (item.zonagast|default([]))|map(t => t.tid)|join(',') %}
          {% set precios = (item.field_rango_de_precios|default([]))|map(t => t.tid)|join(',') %}
          <li class="card" data-categoria="{{ categorias }}" data-zona="{{ zonas }}" data-precios="{{ precios }}">
            <a href="{{ item.url }}">
              <span class="image"><img src="{{ item.image_full ?: item.image }}" alt="{{ item.title }}" loading="lazy" decoding="async"></span>
              <span class="title">{{ item.title }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>

    </div>
  </section>

</div>
