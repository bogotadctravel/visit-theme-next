{#
  Ficha de atractivo — estructura del prototipo v3 (visitbogota3-theme/single-place.html).
  Datos de visit_theme_preprocess_node() (caso 'atractivos'):
    translated_turcat/tursubcat, nodos_cercanos, body_sin_estilos, campos del nodo.
  Estilos en css/overrides.css (scss/_place.scss); interacción en js/overrides.js.
#}
{% import "@visit_theme_next/includes/_conecta_urls.html.twig" as conecta %}
{% set hero_bg = node.field_cover.entity
    ? file_url(node.field_cover.entity.uri.value)
    : (node.field_mainimg.entity ? file_url(node.field_mainimg.entity.uri.value) : '') %}
{% set cat = translated_turcat|first %}
{% set subcat = translated_tursubcat|first %}
{% set lat = node.field_latlong.0.value %}
{% set lng = node.field_latlong.1.value %}

<div class="vn-place">

  {# ================= HERO ================= #}
  <section class="cat-hero cat-hero--tall cat-hero--light" aria-label="{{ node.getTitle() }}">
    {% if hero_bg %}<img class="cat-hero__bg" src="{{ hero_bg }}" alt="" aria-hidden="true">{% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          <li><a href="/que-hacer-en-bogota">{{ 'Descubre Bogotá'|t }}</a></li>
          {% if cat %}<li><a href="{{ conecta.cat_href(cat.label, path('entity.taxonomy_term.canonical', {'taxonomy_term': cat.id})) }}">{{ cat.label }}</a></li>{% endif %}
          {% if subcat %}<li><a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': subcat.id}) }}">{{ subcat.label }}</a></li>{% endif %}
          <li aria-current="page">{{ node.getTitle() }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      {% if node.field_imperdible.value == 1 %}
      <p class="place-hero__kicker">🌟 {{ 'ui.imperdible_badge'|t }}</p>
      {% endif %}
      <h1 class="cat-hero__title">{{ node.getTitle() }}</h1>
    </div>
  </section>

  {# ================= CONTENIDO + SIDEBAR ================= #}
  <section class="place-body">
    <div class="place-body__wrap">

      <article class="place-content">
        {% if body_sin_estilos or node.body.0.value %}
        <div class="place-content__body cat-intro__body--collapsible" id="catIntroBody">
          {% if body_sin_estilos %}{{ body_sin_estilos }}{% else %}{{ node.body.0.value|raw }}{% endif %}
        </div>
        <button class="cat-intro__toggle" type="button" id="catIntroToggle"
          aria-expanded="false" aria-controls="catIntroBody">
          <span class="cat-intro__toggle-label">{{ 'Leer más'|t }}</span>
          <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        {% endif %}
      </article>

      <aside class="place-sidebar">
        <div class="place-sidebar__card">

          {% if node.field_direccion.0.value %}
          <div class="place-sidebar__row place-sidebar__row--address">
            <span class="place-sidebar__value">{{ node.field_direccion.0.value }}</span>
          </div>
          {% endif %}

          {% if node.field_horarios.0.value %}
          <div class="place-sidebar__row">
            <span class="place-sidebar__label">{{ 'ui.opening_hours'|t }}</span>
            <span class="place-sidebar__value">{{ node.field_horarios.0.value|nl2br }}</span>
          </div>
          {% endif %}

          {% if node.field_valor_de_la_entrada.0.value %}
          <div class="place-sidebar__row">
            <span class="place-sidebar__label">{{ 'ui.admission_fee'|t }}</span>
            <span class="place-sidebar__value">{{ node.field_valor_de_la_entrada.0.value|nl2br }}</span>
          </div>
          {% endif %}

          {% if node.field_duracion_de_la_visita_new.0.value %}
          <div class="place-sidebar__row">
            <span class="place-sidebar__label">{{ 'ui.suggested_duration'|t }}</span>
            <span class="place-sidebar__value">{{ node.field_duracion_de_la_visita_new.0.value }}</span>
          </div>
          {% endif %}

          {% if node.field_weblink.0.url %}
          <div class="place-sidebar__row">
            <span class="place-sidebar__label">{{ 'ui.official_website'|t }}</span>
            <a class="place-sidebar__link" href="{{ node.field_weblink.0.url }}" target="_blank" rel="noopener noreferrer">{{ node.field_weblink.0.title ?: (node.field_weblink.0.uri|replace({'https://':'', 'http://':'', 'www.':''})|trim('/')) }}</a>
          </div>
          {% endif %}

          {% if node.field_weblink.0.url %}
          <a class="btn btn--primary place-sidebar__btn" href="{{ node.field_weblink.0.url }}" target="_blank" rel="noopener noreferrer">{{ 'ui.more_information'|t }}</a>
          {% endif %}
          {% if node.field_mapslink.0.url %}
          <a class="btn place-sidebar__btn place-sidebar__btn--secondary" href="{{ node.field_mapslink.0.url }}" target="_blank" rel="noopener noreferrer">{{ 'ui.how_to_get_maps'|t }}</a>
          {% endif %}

        </div>
      </aside>

    </div>
  </section>

  {# ================= GALERÍA ================= #}
  {% if node.field_picgallery|length > 0 %}
  <section class="place-gallery-section">
    <div class="place-gallery-section__head">
      <h2 class="place-gallery-section__title">{{ 'Galería'|t }}</h2>
    </div>
    <ul class="place-gallery place-gallery-section__wrap">
      {% for item in node.field_picgallery|slice(0, 8) %}
      <li>
        <button class="place-gallery__item" type="button"
          data-gallery-src="{{ file_url(item.entity.fileuri) }}"
          aria-label="{{ 'Ver foto'|t }}: {{ item.alt ?: node.getTitle() }}">
          <img src="{{ file_url(item.entity.uri.value) }}" alt="{{ item.alt }}" loading="lazy" decoding="async">
        </button>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {# ================= CÓMO LLEGAR ================= #}
  {% set arcgis_url = arcgis_experience_url(node.id()) %}
  {% if arcgis_url or (lat and lng) %}
  <section class="place-map-section">
    <div class="place-map-section__head">
      <h2 class="place-map-section__title">{{ 'ui.how_to_get_there'|t }}</h2>
    </div>
    <div class="place-map-section__wrap">
      <div class="place-map{% if arcgis_url %} place-map--embed{% endif %}"{% if not arcgis_url %} role="img" aria-label="{{ 'Ubicación de'|t }} {{ node.getTitle() }}"{% endif %}>
        {% if arcgis_url %}
        <iframe src="{{ arcgis_url }}" title="{{ 'Mapa'|t }}: {{ node.getTitle() }}" loading="lazy" allowfullscreen></iframe>
        {% else %}
        <div class="place-map__grid" aria-hidden="true"></div>
        <div class="place-map__pin" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.3-7-11.5A7 7 0 0 1 19 9.5C19 14.7 12 21 12 21Z" stroke-width="1.4" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.6"/></svg>
        </div>
        {% if node.field_direccion.0.value %}<span class="place-map__label">{{ node.field_direccion.0.value }}</span>{% endif %}
        {% endif %}
        {% if lat and lng %}
        <a class="place-map__transmi" href="https://lab.visitbogota.co/transmilenio/?latdestino={{ lat }}&longdestino={{ lng }}&title={{ node.getTitle()|url_encode }}" target="_blank" rel="noopener noreferrer">
          <img src="/{{ subtheme_path ?: directory }}/images/transmilenio-logo.png" alt="" aria-hidden="true">
          <span>{{ 'Cómo llegar en transporte público'|t }}</span>
        </a>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ================= LUGARES RELACIONADOS ================= #}
  {% set relacionados = nodos_cercanos ?: contenidos_relacionados %}
  {% if relacionados is not empty %}
  <section class="cat-related">
    <div class="cat-related__head">
      <h2 class="cat-related__title">{{ 'Lugares relacionados'|t }}</h2>
    </div>
    <div class="cat-related__group">
      <ul class="cat-related__grid cat-related__grid--atractivos">
        {% for item in relacionados|slice(0, 4) %}
        <li>
          <a class="card-imperdible" href="{{ item.url }}">
            <span class="card-imperdible__media">
              <img class="card-imperdible__img" src="{{ item.image_full ?: item.image }}" alt="{{ item.title }}" loading="lazy" decoding="async">
            </span>
            <span class="card-imperdible__title">{{ item.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

</div>

{# ================= MODAL: foto de la galería ================= #}
<div class="vn-modal" id="galleryModal" hidden>
  <div class="vn-modal__backdrop" data-modal-close></div>
  <div class="vn-modal__dialog vn-modal__dialog--image" role="dialog" aria-modal="true" aria-label="{{ 'Foto de la galería'|t }}">
    <button class="vn-modal__close" type="button" data-modal-close aria-label="{{ 'ui.close'|t }}">&times;</button>
    <img class="vn-modal__image" id="galleryModalImg" src="" alt="">
  </div>
</div>
