{#
  Página de subcategoría (vocabulario subcategorias_2026) — estructura del
  prototipo v3 (visitbogota3-theme/subcategory.html).
  Datos: visit_theme_next_preprocess_taxonomy_term() (atractivos, reels)
  + taxonomy('categorias_2026', ids) para el breadcrumb de la categoría padre.
  "También te puede interesar" = reels de Instagram (tipo de contenido `reels`,
  field_tursubcat = esta subcategoría); el click abre el post embebido en .vn-modal.
#}
{% import "@visit_theme_next/includes/_conecta_urls.html.twig" as conecta %}
{% set sub_bg = term.field_imagen_principal.entity
    ? file_url(term.field_imagen_principal.entity.uri.value) : '' %}

{% set parent_ids = [] %}
{% for rel in term.field_rel_cat %}
  {% set parent_ids = parent_ids|merge([rel.target_id]) %}
{% endfor %}
{% set parent_cats = parent_ids is not empty ? taxonomy('categorias_2026', parent_ids) : [] %}
{% set parent_cat = parent_cats|first %}

{# Subcategorías de "Bogotá corporativa" (Proveedores, Venues) viven en el
   micrositio Conecta. Redirección de respaldo (lo ideal: un Redirect de config). #}
{% set conecta_sub = parent_cat ? conecta.subcat_href(term.name.value, '', parent_cat.name) : '' %}
{% if conecta_sub starts with '/conecta' %}
<script>window.location.replace('{{ conecta_sub }}');</script>
<noscript><meta http-equiv="refresh" content="0; url={{ conecta_sub }}"></noscript>
{% endif %}

<div class="vn-cat vn-cat--sub">

  {# ================= HERO ================= #}
  <section class="cat-hero cat-hero--tall cat-hero--light" aria-label="{{ term.name.value }}">
    {% if sub_bg %}<img class="cat-hero__bg" src="{{ sub_bg }}" alt="" aria-hidden="true">{% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          {% if parent_cat %}<li><a href="{{ conecta.cat_href(parent_cat.name, parent_cat.url) }}">{{ parent_cat.name }}</a></li>{% endif %}
          <li aria-current="page">{{ term.name.value }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      <h1 class="cat-hero__title">{{ term.name.value }}</h1>
    </div>
  </section>

  {# ================= INTRO ================= #}
  <section class="cat-layout cat-layout--tight">
    <div class="cat-layout__wrap">
      <article class="cat-layout__main">
        {% if term.description.value %}
        <div class="cat-intro__body cat-intro__body--collapsible" id="catIntroBody">
          {{ term.description.value|raw }}
        </div>
        <button class="cat-intro__toggle" type="button" id="catIntroToggle"
          aria-expanded="false" aria-controls="catIntroBody">
          <span class="cat-intro__toggle-label">{{ 'Leer más'|t }}</span>
          <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        {% endif %}
      </article>
    </div>
  </section>
  {# Aviso legal traducible: una sola cadena para t(). El enlace va inline con el
     placeholder :url (Drupal permite HTML literal en el texto fuente de t()).
     La versión EN se gestiona en admin/config/regional/translate o en un .po. #}
  <div class="disclaimer" style="padding: 20px; background-color: #f9f9f9; margin: 20px auto; max-width: 800px; border-radius: 8px;">
    <p style="margin: 0; font-size: 14px;">{{ 'El IDT no asume responsabilidad por los acuerdos, servicios, controversias o reclamaciones que puedan surgir entre los usuarios y los establecimientos incluidos en visitbogota.co, siendo dichas relaciones de exclusiva responsabilidad de las partes involucradas. ¿No ves tu establecimiento aquí? Puedes registrarlo en <a href=":url" target="_blank" rel="noopener noreferrer" style="color: #007bff; text-decoration: underline;">este enlace</a>.'|t({':url': 'https://forms.gle/2zfNkZ34hz1P2ppi7'}) }}</p>
  </div>
  {# ================= ATRACTIVOS ================= #}
  {% if atractivos is not empty %}
  <section class="cat-attractions">
    <div class="cat-attractions__wrap">
      <div class="cat-attractions__head">
        <h2 class="cat-attractions__title">{{ 'Atractivos'|t }}</h2>
        {% if atractivos|length > 8 %}
        <a class="btn btn--ghost cat-attractions__cta" href="/atractivos/{{ term.id() }}">{{ 'Explorar todo'|t }} {{ term.name.value }}</a>
        {% endif %}
      </div>
      <ul class="cat-attractions__grid">
        {% for item in atractivos|slice(0, 8) %}
        <li>
          <a class="card-imperdible" href="{{ item.url }}">
            <span class="card-imperdible__media">
              <img class="card-imperdible__img" src="{{ item.image_full ?: item.image }}"
                alt="{{ item.title }}" loading="lazy" decoding="async">
            </span>
            <span class="card-imperdible__title">{{ item.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {# ================= DÓNDE COMER (establecimientos) ================= #}
  {% if establecimientos is not empty %}
  <section class="cat-attractions cat-attractions--eat">
    <div class="cat-attractions__wrap">
      <div class="cat-attractions__head">
        <h2 class="cat-attractions__title">{{ 'Dónde comer'|t }}</h2>
      </div>
      <ul class="cat-attractions__grid">
        {% for item in establecimientos|slice(0, 8) %}
        <li>
          <a class="card-imperdible" href="{{ item.url }}">
            <span class="card-imperdible__media">
              <img class="card-imperdible__img" src="{{ item.image_full ?: item.image }}"
                alt="{{ item.title }}" loading="lazy" decoding="async">
            </span>
            <span class="card-imperdible__title">{{ item.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {# ================= TAMBIÉN TE PUEDE INTERESAR (reels de Instagram) ================= #}
  {% if reels is not empty %}
  <section class="cat-videos">
    <div class="cat-videos__wrap">
      <h2 class="cat-videos__title">{{ 'También te puede interesar'|t }}</h2>
      <ul class="cat-videos__grid">
        {% for reel in reels|slice(0, 6) %}
        <li>
          <button class="card-video" type="button" data-instagram-url="{{ reel.instagram_url }}"
            aria-label="{{ 'Ver publicación de Instagram'|t }}{% if reel.title %}: {{ reel.title }}{% endif %}">
            {% if reel.cover_url %}
            <img class="card-video__img" src="{{ reel.cover_url }}" alt="" loading="lazy" decoding="async">
            {% endif %}
            <span class="card-video__play" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </span>
          </button>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

</div>

{% if reels is not empty %}
{# Namespaced .vn-modal para no chocar con el .modal del tema base. #}
<div class="vn-modal" id="instagramModal" hidden>
  <div class="vn-modal__backdrop" data-modal-close></div>
  <div class="vn-modal__dialog" role="dialog" aria-modal="true" aria-label="{{ 'Publicación de Instagram'|t }}">
    <button class="vn-modal__close" type="button" data-modal-close aria-label="{{ 'ui.close'|t }}">&times;</button>
    <div class="vn-modal__body" id="instagramModalBody"></div>
  </div>
</div>
{% endif %}
