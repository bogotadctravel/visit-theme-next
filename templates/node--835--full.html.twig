{#
  Nodo 835 — "Experiencias / ofertas" (/experiencias-turisticas): listado de
  experiencias NO aliadas IDT con filtros. Misma estructura que el nodo 1280
  (experiencias certificadas) — ver ese archivo para más contexto. Datos:
  $experiencias (visit_theme_preprocess_node, caso 'page', filtrado por
  field_experiencia_aliada_idt=0).
#}
{% set hero_bg = node.field_mainimg.entity
    ? file_url(node.field_mainimg.entity.uri.value)
    : (node.field_cover.entity ? file_url(node.field_cover.entity.uri.value) : '') %}

<div class="vn-archive">

  {# ================= HERO ================= #}
  <section class="cat-hero cat-hero--tall" aria-label="{{ node.getTitle() ?: 'ui.tourist_experiences_heading'|t }}">
    {% if hero_bg %}<img class="cat-hero__bg" src="{{ hero_bg }}" alt="" aria-hidden="true">{% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          <li aria-current="page">{{ node.getTitle() ?: 'ui.tourist_experiences_heading'|t }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      <h1 class="cat-hero__title">{{ node.getTitle() ?: 'ui.tourist_experiences_heading'|t }}</h1>
    </div>
  </section>

  {# ================= LISTADO ================= #}
  <section class="archive">
    <div class="archive__wrap">

      <div class="archive__results-head" style="grid-column:1/-1">
        <p class="archive__count">{{ experiencias|length }} {{ 'experiencias'|t }}</p>
      </div>

      <aside>
        <button class="filter-toggle-btn" type="button" aria-expanded="false" aria-controls="filters-panel">
          <span>{{ 'Filtros'|t }}</span>
          <svg class="filter-toggle-btn__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="filters" id="filters-panel">
          <h3>{{ 'ui.category'|t }}</h3>
          {% for cat in taxonomy('categorias_turisticas') %}
          <label for="f-{{ cat.tid }}"><input type="checkbox" id="f-{{ cat.tid }}" value="{{ cat.tid }}"> {{ cat.name }}</label>
          {% endfor %}
          <h3>{{ '¿Para quién?'|t }}</h3>
          {% for cat in taxonomy('recomendaciones') %}
          <label for="f-{{ cat.tid }}"><input type="checkbox" id="f-{{ cat.tid }}" value="{{ cat.tid }}"> {{ cat.name }}</label>
          {% endfor %}
        </div>
      </aside>

      <div class="archive__results">
        {% if experiencias is not empty %}
        <ul class="archive__grid" id="cardsList">
          {% for item in experiencias|shuffle %}
          {% set para = (item.field_turpara|default([]))|map(t => t.tid)|join(',') %}
          <li class="card" data-categoria="{{ item.categoria.tid ?? '' }}" data-para="{{ para }}">
            <a href="{{ item.url }}">
              <span class="image"><img src="{{ item.image_full ?: item.image ?: 'https://placehold.co/600x400' }}" alt="{{ item.title }}" loading="lazy" decoding="async"></span>
              <span class="title">{{ item.title }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>

    </div>
  </section>

</div>
