{#
  Header del subtema visit_theme_next — estructura y clases del prototipo v3
  (visitbogota3-theme: .masthead / .mainnav / .megamenu / .dropdown / .burger),
  cableado a los datos de Drupal del header original de visit_theme:
    · menu_principal_visitbogota  → ítems del menú principal (barra 2)
    · menu_topbar_visit           → enlaces externos (solo panel móvil)
    · taxonomy('categorias_turisticas' / 'subcategorias_turisticas') → mega "Descubre Bogotá"
    · page.headerVisit            → selector de idioma
    · page.bannersHeader          → banners sobre el header
  Estilos en css/overrides.css (scss/_header.scss); interacción en js/overrides.js.
#}
<a href="#main-content" class="skip-link">{{ 'ui.skip_to_content'|t }}</a>

{{ page.bannersHeader }}

<header class="masthead" id="masthead">

  {# ── Barra 1: logo, buscador y selector de idioma ── #}
  <div class="masthead__bar1">
    <div class="masthead__bar1-inner">

      <a class="brand" href="/" aria-label="{{ 'ui.home'|t }} – Visit Bogotá">
        <img class="brand__logo" src="/{{ subtheme_path ?: directory }}/images/visitlogo.svg"
          alt="Visit Bogotá" width="472" height="113" loading="eager" decoding="async">
      </a>

      <div class="masthead__tools">

        {# Buscador: se conserva el markup del overlay del tema base
           (lo maneja el behavior "idt-search-toggle" de visit_theme/global-styling). #}
        <div class="search-comp">
          <button type="button" id="openSearch" class="search-trigger"
            aria-label="{{ 'ui.open_search'|t }}" aria-expanded="false" aria-controls="search-overlay">
            <svg class="search-trigger__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="search-trigger__label">{{ 'ui.search_placeholder'|t }}</span>
          </button>
          <div class="overlay" id="search-overlay" role="dialog" aria-modal="true"
            aria-label="{{ 'ui.search'|t }}" hidden>
            <button type="button" class="close" aria-label="{{ 'ui.close_search'|t }}">
              <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true" focusable="false">
                <path d="M20.67 17.84L35.09 3.42C35.87 2.64 35.87 1.37 35.09 0.589998C34.31 -0.190002 33.04 -0.190002 32.26 0.589998L17.84 15.01L3.41 0.589998C2.63 -0.200002 1.37 -0.200002 0.589998 0.589998C-0.200002 1.37 -0.200002 2.63 0.589998 3.41L15.01 17.83L0.589998 32.26C-0.190002 33.04 -0.190002 34.31 0.589998 35.09C0.979998 35.48 1.49 35.68 2 35.68C2.51 35.68 3.02 35.48 3.41 35.09L17.83 20.67L32.25 35.09C32.64 35.48 33.15 35.68 33.66 35.68C34.17 35.68 34.68 35.48 35.07 35.09C35.85 34.31 35.85 33.04 35.07 32.26L20.65 17.84H20.67Z" fill="currentColor"/>
              </svg>
            </button>
            <div class="content">
              <label for="search-input" class="sr-only">{{ 'ui.search_placeholder'|t }}</label>
              <input type="text" name="search-input" id="search-input"
                placeholder="{{ 'ui.search_placeholder'|t }}" autocomplete="off">
              <ul id="search-results" role="listbox" aria-live="polite" aria-atomic="false"></ul>
            </div>
          </div>
        </div>

        {# Selector de idioma (región headerVisit del tema base). #}
        <div class="masthead__lang">
          {% if page.headerVisit is defined %}{{ page.headerVisit }}{% endif %}
        </div>

      </div>
    </div>
  </div>

  {# ── Barra 2: menú principal ── #}
  <div class="masthead__bar2">
    <div class="masthead__bar2-inner">

      <nav class="mainnav" id="mainnav" aria-label="{{ 'Navegación principal'|t }}">
        <ul>

          {# ── Descubre Bogotá — mega menú (categorías + subcategorías) ── #}
          {% set categorias = taxonomy('categorias_2026') %}
          {% set subcategorias = taxonomy('subcategorias_2026') %}
          {% set has_tax = categorias is not empty %}

          <li class="mainnav__item{% if has_tax %} dropdown mainnav__item--mega{% endif %}">
            <a class="mainnav__link{% if has_tax %} dropdown__toggle{% endif %}" href="/que-hacer-en-bogota"
              {% if has_tax %}aria-expanded="false" aria-controls="mega-descubre"{% endif %}>
              {{ 'ui.what_to_do'|t }}
              {% if has_tax %}
              <svg class="caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {% endif %}
            </a>

            {% if has_tax %}
            <div class="dropdown__menu megamenu" id="mega-descubre" hidden>
              <div class="megamenu__inner">

                <ul class="megamenu__cats">
                  {% for cat in categorias %}
                  <li>
                    <button class="megamenu__cat" type="button" data-cat="cat-{{ cat.tid }}">{{ cat.name }}</button>
                  </li>
                  {% endfor %}
                </ul>

                <div class="megamenu__panels">
                  {% for cat in categorias %}
                  {% set cat_subcats = [] %}
                  {% for subcat in subcategorias %}
                  {% set rel_tids = [] %}
                  {% for rel in subcat.cat_rel %}
                  {% set rel_tids = rel_tids|merge([rel.tid]) %}
                  {% endfor %}
                  {% if cat.tid in rel_tids and subcat.tid != 202 %}
                  {% set cat_subcats = cat_subcats|merge([subcat]) %}
                  {% endif %}
                  {% endfor %}

                  <div class="megamenu__panel" data-panel="cat-{{ cat.tid }}" hidden>
                    <a class="megamenu__panel-link" href="{{ cat.url }}">
                      {{ 'Ver toda la categoría'|t }} {{ cat.name }}
                      <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                        <path d="M2 8l6-6M3 2h5v5" fill="none" stroke="currentColor" stroke-width="1.4"
                          stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                    {% for subcat in cat_subcats %}
                    <a class="megamenu__sub" href="{{ subcat.url }}">
                      <span class="megamenu__sub-media">
                        {% if subcat.image_thumb or subcat.image %}
                        <img src="{{ subcat.image_thumb ?: subcat.image }}" alt="" loading="lazy" decoding="async">
                        {% endif %}
                      </span>
                      <span class="megamenu__sub-title">{{ subcat.name }}</span>
                    </a>
                    {% endfor %}
                  </div>
                  {% endfor %}
                </div>

              </div>
            </div>
            {% endif %}
          </li>

          {# ── Ítems dinámicos del menú principal ── #}
          {% for item in menu_principal_visitbogota['#items'] %}
          {% set item_classes = item.attributes.class ? item.attributes.class|join(' ') : '' %}
          <li class="mainnav__item {{ item_classes }}{% if item.below %} dropdown{% endif %}">
            <a class="mainnav__link{% if item.below %} dropdown__toggle{% endif %}" href="{{ item.url }}"
              {% if item.below %}aria-expanded="false" aria-controls="dd-{{ loop.index }}"{% endif %}>
              {{ item.title }}
              {% if item.below %}
              <svg class="caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {% endif %}
            </a>
            {% if item.below %}
            <ul class="dropdown__menu" id="dd-{{ loop.index }}" hidden>
              {% for subitem in item.below %}
              <li><a href="{{ subitem.url }}">{{ subitem.title }}</a></li>
              {% for nested in subitem.below %}
              <li><a href="{{ nested.url }}">{{ nested.title }}</a></li>
              {% endfor %}
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}

          {# ── Enlaces externos del topbar: solo visibles dentro del panel móvil ── #}
          {% if menu_topbar_visit['#items'] is not empty %}
          <li class="mainnav__item mainnav__topbar-mobile">
            <ul class="mainnav__topbar-list">
              {% for item in menu_topbar_visit['#items'] %}
              <li>
                <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
                {% if item.below %}
                <ul>
                  {% for subitem in item.below %}
                  <li><a href="{{ subitem.url }}" target="_blank" rel="noopener noreferrer">{{ subitem.title }}</a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </li>
          {% endif %}

        </ul>
      </nav>

      <button class="burger" id="burger" aria-expanded="false" aria-controls="mainnav"
        aria-label="{{ 'ui.open_menu'|t }}">
        <span></span><span></span><span></span>
      </button>

    </div>
  </div>

</header>
