{#
  Footer del subtema visit_theme_next — estructura y clases del prototipo v3
  (visitbogota3-theme: .site-footer con fondo rojo).
  Datos del tema base:
    · site_info (whatsapp, redes)            → visit_theme_preprocess_page()
    · taxonomy('categorias_2026')            → columna "Descubre Bogotá"
    · mas_opciones['#items']                 → columna "Más opciones"
  Estilos en css/overrides.css (scss/_footer.scss).
#}
{% import "@visit_theme_next/includes/_conecta_urls.html.twig" as conecta %}
<footer class="site-footer site-footer--next">
  <div class="site-footer__top">

    <div class="site-footer__brand">
      <img class="site-footer__logo" src="/{{ subtheme_path ?: directory }}/images/visitlogo-blanco.svg"
        alt="Visit Bogotá" width="472" height="113" loading="lazy" decoding="async">
      <p class="site-footer__tagline">{{ 'Bogotá, tu casa.'|t }}</p>

      <ul class="site-footer__social">
        {% if site_info.facebook %}
        <li><a href="{{ site_info.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/faceb.svg" alt="" width="24" height="24" loading="lazy" decoding="async"></a></li>
        {% endif %}
        {% if site_info.instagram %}
        <li><a href="{{ site_info.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/insta.svg" alt="" width="24" height="24" loading="lazy" decoding="async"></a></li>
        {% endif %}
        {% if site_info.tiktok %}
        <li><a href="{{ site_info.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/tiktok.svg" alt="" width="24" height="24" loading="lazy" decoding="async"></a></li>
        {% endif %}
        {% if site_info.youtube %}
        <li><a href="{{ site_info.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/yt.svg" alt="" width="24" height="24" loading="lazy" decoding="async"></a></li>
        {% endif %}
      </ul>
    </div>

    <div class="site-footer__links">
      <div class="site-footer__col">
        <h3 class="site-footer__heading">{{ 'Atención al usuario'|t }}</h3>
        <ul class="site-footer__contact">
          {% if site_info.whatsapp %}
          <li><a href="{{ site_info.whatsapp }}" target="_blank" rel="noopener noreferrer">
            <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/atencion.svg" alt="" width="22" height="22" loading="lazy" decoding="async">
            <span>{{ 'ui.tourist_support'|t }}</span>
          </a></li>
          {% endif %}
          <li>
            <img src="/{{ subtheme_path ?: directory }}/images/iconosfooter/ubicacion.svg" alt="" width="22" height="22" loading="lazy" decoding="async">
            <address>Carrera 10 N.º 28-49<br>Edificio Centro Internacional<br>Bogotá D.C., Colombia.</address>
          </li>
        </ul>
      </div>

      {% set categorias_footer = taxonomy('categorias_2026') %}
      {% if categorias_footer is not empty %}
      <nav class="site-footer__col" aria-label="{{ 'Descubre Bogotá'|t }}">
        <h3 class="site-footer__heading">{{ 'Descubre Bogotá'|t }}</h3>
        <ul>
          {% for item in categorias_footer %}
          <li><a href="{{ conecta.cat_href(item.name, item.url) }}">{{ item.name }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}

      {% if mas_opciones['#items'] is not empty %}
      <nav class="site-footer__col" aria-label="{{ 'ui.more_options'|t }}">
        <h3 class="site-footer__heading">{{ 'ui.more_options'|t }}</h3>
        <ul>
          {% for item in mas_opciones['#items'] %}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </div>

    {# App móvil oficial "Visit Bogotá" (IDT) #}
    <div class="site-footer__app">
      <p class="site-footer__app-title">{{ 'Descarga la app móvil de Bogotá'|t }}</p>
      {# TEMPORAL: comparación de estilos de botones de tiendas. Dejar solo la opción elegida. #}
      
      <ul class="site-footer__stores site-footer__stores--outline">
        <li><a class="site-footer__store" href="https://play.google.com/store/apps/details?id=com.servinf.test.bogotadctravel" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Descargar en Google Play'|t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.3 13.4 12l-9.8 9.7c-.4-.2-.6-.6-.6-1.1V3.4c0-.5.2-.9.6-1.1Z" fill="#00d7fe"/><path d="m16.8 8.6-3.4 3.4-9.8-9.7c.3-.2.8-.2 1.2 0l12 6.3Z" fill="#00f076"/><path d="m16.8 15.4-12 6.3c-.4.2-.9.2-1.2 0l9.8-9.7 3.4 3.4Z" fill="#ff3a44"/><path d="M20.3 13.3 16.8 15.4 13.4 12l3.4-3.4 3.5 2.1c1 .6 1 2 0 2.6Z" fill="#ffd500"/></svg>
          <span class="site-footer__store-text">{{ 'Disponible en'|t }}<strong>Google Play</strong></span>
        </a></li>
        <li><a class="site-footer__store" href="https://apps.apple.com/co/app/id1478036261" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Descargar en App Store'|t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9-1.7 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.4-.9-2.4-3.7ZM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4Z" fill="currentColor"/></svg>
          <span class="site-footer__store-text">{{ 'Descárgala en'|t }}<strong>App Store</strong></span>
        </a></li>
      </ul>
    
    </div>

    {% include "@visit_theme_next/includes/_disclaimer_establecimientos.html.twig" %}

  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copy">{{ 'now'|date('Y') }} © {{ 'ui.all_rights_reserved'|t }}</p>
    <ul class="site-footer__legal">
      <li><a href="{{ path('entity.node.canonical', {'node': 704}) }}">{{ 'ui.privacy_policy'|t }}</a></li>
      <li><a target="_blank" rel="noopener noreferrer" href="https://files.visitbogota.co/sites/default/files/2022-03/Res.%20239%205-11-2021%20Por%20la%20cual%20se%20reglmente%20el%20acceso%20a%20un%20banco%20de%20imagenes%20del%20IDT.pdf">{{ 'ui.resolution_239'|t }}</a></li>
      <li><a target="_blank" rel="noopener noreferrer" href="https://www.idt.gov.co/marca-bogota">{{ 'ui.city_brand'|t }}</a></li>
    </ul>
  </div>
</footer>

<div id="root"></div>
