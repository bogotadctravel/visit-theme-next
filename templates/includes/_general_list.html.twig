{#
  Listado general reutilizable — prototipo v3 (visitbogota3-theme/general-list.html).
  Hero + cuadrícula de 4 columnas de tarjetas simples (card-imperdible horizontal).
  Parámetros:
    · list_title   — título del hero y <h1>
    · list_items   — array de teasers (buildTeaserOutput: title, url, image, image_full)
    · list_hero_bg — URL de imagen de fondo del hero (opcional)
    · list_pager   — render array del paginador (opcional)
    · list_crumb   — etiqueta del breadcrumb actual (por defecto, list_title)
    · subtheme_path / directory — para el logo del hero
#}
<div class="vn-cat vn-general-list">

  <section class="cat-hero cat-hero--tall" aria-label="{{ list_title }}">
    {% if list_hero_bg %}<img class="cat-hero__bg" src="{{ list_hero_bg }}" alt="" aria-hidden="true">{% endif %}
    <div class="cat-hero__topright">
      <img class="hero-logo-mark" src="/{{ subtheme_path ?: directory }}/images/logo-bogota-original.svg" alt="Bogotá">
      <nav class="breadcrumb" aria-label="{{ 'Ruta de navegación'|t }}">
        <ol>
          <li><a href="/">{{ 'Inicio'|t }}</a></li>
          <li aria-current="page">{{ list_crumb ?: list_title }}</li>
        </ol>
      </nav>
    </div>
    <div class="cat-hero__banner">
      <h1 class="cat-hero__title">{{ list_title }}</h1>
    </div>
  </section>

  <section class="general-list">
    <div class="general-list__wrap">
      {% if list_items is not empty %}
      {% set total = list_items|length %}
      <div class="general-list__head">
        <p class="general-list__count">
          {% trans %}{{ total }} registro encontrado{% plural total %}{{ total }} registros encontrados{% endtrans %}
        </p>
      </div>
      <ul class="general-list__grid">
        {% for item in list_items %}
        <li>
          <a class="card-imperdible" href="{{ item.url }}">
            <span class="card-imperdible__media">
              <img class="card-imperdible__img" src="{{ item.image_full ?: item.image }}" alt="{{ item.title }}" loading="lazy" decoding="async">
            </span>
            <span class="card-imperdible__title">{{ item.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% if list_pager %}
      <div class="general-list__pager">{{ list_pager }}</div>
      {% endif %}
      {% endif %}
    </div>
  </section>

</div>
