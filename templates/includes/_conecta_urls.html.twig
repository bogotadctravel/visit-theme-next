{#
  "Bogotá corporativa" y sus subcategorías (Proveedores, Venues) apuntan al
  micrositio Conecta (/conecta, /conecta/proveedores, /conecta/venues) en vez de
  a su página de taxonomía. Se detecta por nombre (independiente del entorno).

  Uso:
    {% import "@visit_theme_next/includes/_conecta_urls.html.twig" as conecta %}
    <a href="{{ conecta.cat_href(cat.name, cat.url) }}">
    <a href="{{ conecta.subcat_href(subcat.name, subcat.url, parent_name) }}">
#}

{%- macro cat_href(name, fallback) -%}
  {%- if 'corporativa' in name|lower -%}/conecta{%- else -%}{{ fallback }}{%- endif -%}
{%- endmacro -%}

{%- macro subcat_href(name, fallback, parent_name) -%}
  {%- set n = name|lower -%}
  {%- if parent_name is defined and 'corporativa' in parent_name|lower -%}
    {%- if 'proveedor' in n -%}/conecta/proveedores
    {%- elseif 'venue' in n -%}/conecta/venues
    {%- else -%}{{ fallback }}
    {%- endif -%}
  {%- elseif 'donde comer' in n or 'dónde comer' in n or 'restaurante' in n -%}
    {#- "Donde comer" va directo al listado de restaurantes (nodo 562), no a
        la página de la subcategoría de taxonomía. Ajustar el string de match
        si el nombre real del término en Drupal difiere de estos. -#}
    {{ path('entity.node.canonical', {'node': 562}) }}
  {%- else -%}{{ fallback }}{%- endif -%}
{%- endmacro -%}
